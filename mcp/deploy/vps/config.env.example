# Change ALLOWED_FOLDER_IDS only after notesctl -action folders.
# DO NOT put Apple ID, Apple password, 2FA, cookies, API keys or tokens here.
MCP_BIND=127.0.0.1:8765
ICLOUD_STATE_DIR=/var/lib/notes-mcp
ALLOWED_FOLDER_IDS=REPLACE_WITH_YOUR_ICLOUD_FOLDER_ID
MAX_SCAN_NOTES=1000
ICLOUD_READ_TIMEOUT=90s
MCP_CACHE_SECONDS=120
